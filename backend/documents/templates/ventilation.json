{
  "version": "m100-ventilation-v1",
  "source": "Зп аэродром.xlsx, Лист1 C5:G28",
  "query_terms": {
    "Вентиляция": [
      "вентиляция",
      "воздуховод"
    ],
    "Отопление": [
      "отопление",
      "теплопровод",
      "теплоснабжение"
    ],
    "Водоснабжение": [
      "водоснабжение",
      "водопровод",
      "хвс",
      "гвс"
    ],
    "Канализация": [
      "канализация"
    ],
    "Кондиционирование": [
      "кондиционирование",
      "фреон"
    ],
    "Электроснабжение": [
      "электроснабжение",
      "электрика",
      "кабель"
    ],
    "Автоматика": [
      "автоматика",
      "слаботочка"
    ]
  },
  "works": [
    {
      "id": "ahu",
      "name": "Монтаж приточно-вытяжных установок",
      "unit": "шт.",
      "pattern": "(?:приточн|приточно[ -]вытяжн|вытяжн)\\w*\\s+установ",
      "aggregation": "sum"
    },
    {
      "id": "radial_fan",
      "name": "Монтаж вентиляторов (радиальных)",
      "unit": "шт.",
      "pattern": "вентилятор.*радиальн|радиальн.*вентилятор",
      "aggregation": "sum"
    },
    {
      "id": "duct_fan",
      "name": "Монтаж вентиляторов (канальных, осевой)",
      "unit": "шт.",
      "pattern": "вентилятор.*(?:канальн|осев)|(?:канальн|осев).*вентилятор",
      "aggregation": "sum"
    },
    {
      "id": "industrial_diffuser",
      "name": "Монтаж диффузоров индустриальных",
      "unit": "шт.",
      "pattern": "(?=.*диффузор)(?=.*индустриальн)",
      "aggregation": "sum"
    },
    {
      "id": "diffuser",
      "name": "Монтаж ДПУ (диффузор универсальный, вихревой)",
      "unit": "шт.",
      "pattern": "(?=.*диффузор)(?=.*(?:универсальн|вихрев))|\\bдпу\\b",
      "aggregation": "sum"
    },
    {
      "id": "grille_connection",
      "name": "Узел подключения к решеткам",
      "unit": "шт.",
      "pattern": "(?=.*(?:уз[её]л|узла|подключен))(?=.*реш[её]т)",
      "aggregation": "sum"
    },
    {
      "id": "grille",
      "name": "Установка решеток (регулируемая)",
      "unit": "шт.",
      "pattern": "(?=.*реш[её]тк)(?=.*регулируем)",
      "aggregation": "sum",
      "exclude_pattern": "шибер|шидер|защитн"
    },
    {
      "id": "fireproof",
      "name": "Устройство огнезащитного покрытия воздуховодов",
      "unit": "м²",
      "pattern": "огнезащ|покрыти.*(?:е[il1]?\\s*30|ei30)",
      "aggregation": "sum"
    },
    {
      "id": "intake",
      "name": "Монтаж воздухоприемных устройств",
      "unit": "шт.",
      "pattern": "воздухопри[её]мн",
      "aggregation": "sum"
    },
    {
      "id": "throttle",
      "name": "Установка дроссель-клапанов",
      "unit": "шт.",
      "pattern": "дроссель[ -]?клапан",
      "aggregation": "sum"
    },
    {
      "id": "fire_damper",
      "name": "Монтаж противопожарных клапанов",
      "unit": "шт.",
      "pattern": "клапан.*(?:противопожар|огнезадерж)|(?:противопожар|огнезадерж).*клапан",
      "aggregation": "sum"
    },
    {
      "id": "silencer",
      "name": "Установка шумоглушителей",
      "unit": "шт.",
      "pattern": "шумоглушител|глушител.*шума|глушител\\w*\\s+прямоугольн",
      "aggregation": "sum"
    },
    {
      "id": "explosion_check",
      "name": "Установка клапанов обратных (взрывозащищенных)",
      "unit": "шт.",
      "pattern": "(?=.*клапан)(?=.*обратн)(?=.*взрыв)",
      "aggregation": "sum"
    },
    {
      "id": "check",
      "name": "Установка клапанов обратных (обычных, универсальный)",
      "unit": "шт.",
      "pattern": "(?=.*клапан)(?=.*(?:обратн|универсальн))",
      "aggregation": "sum"
    },
    {
      "id": "flexible_duct",
      "name": "Монтаж воздуховодов гибких",
      "unit": "м",
      "pattern": "(?=.*воздуховод)(?=.*гибк)",
      "aggregation": "sum"
    },
    {
      "id": "explosion_damper",
      "name": "Заслонка взрывозащищенная",
      "unit": "шт.",
      "pattern": "заслонк.*взрыв|взрыв.*заслонк",
      "aggregation": "sum"
    },
    {
      "id": "motor_damper",
      "name": "Клапан воздушный с электроприводом (гермик)",
      "unit": "шт.",
      "pattern": "(?=.*клапан)(?=.*(?:электр.*привод|электропривод|гермик))",
      "aggregation": "sum"
    },
    {
      "id": "measurement_port",
      "name": "Измерительный порт для отбора проб",
      "unit": "шт.",
      "pattern": "(?=.*порт)(?=.*(?:измерительн|замер|отбор|отдор))",
      "aggregation": "sum",
      "exclude_pattern": "люч|дюч|/юч|ючок"
    },
    {
      "id": "duct",
      "name": "Монтаж воздуховодов",
      "unit": "м²",
      "pattern": "воздуховод",
      "aggregation": "sum",
      "composite_units": {
        "м/м²": [
          "м",
          "м²"
        ],
        "м/м2": [
          "м",
          "м²"
        ],
        "м/м?": [
          "м",
          "м²"
        ]
      },
      "exclude_pattern": "зонт|реш[её]тк|клапан|изоляц|покрыт|переход|креплен|поддон"
    },
    {
      "id": "deflector",
      "name": "Установка дефлекторов",
      "unit": "шт.",
      "pattern": "дефлектор",
      "aggregation": "sum",
      "exclude_pattern": "поддон|под\\s+дефлектор"
    },
    {
      "id": "hood",
      "name": "Установка зонтов",
      "unit": "шт.",
      "pattern": "\\bзонт",
      "aggregation": "sum"
    },
    {
      "id": "insulation",
      "name": "Тепловая изоляция матами",
      "unit": "м²",
      "pattern": "(?:теплоизоляц|изоляц|матами|минераловатн|вертикально[ -]слоист)",
      "aggregation": "sum"
    },
    {
      "id": "consumables",
      "name": "Расходный материал",
      "unit": "компл.",
      "pattern": "кле[йи]|скотч|лента.*алюмини|про[вб]олок|стеклоткан|сетк.*ткан|(?=.*лист)(?=.*покровн)",
      "aggregation": "bundle"
    },
    {
      "id": "passport",
      "name": "Паспортизация систем вентиляции",
      "unit": "систем",
      "pattern": "паспортиз",
      "aggregation": "sum"
    }
  ],
  "ocr_word_aliases": {
    "воздухо[б6]вод": "воздуховод",
    "воздухо[б6]од": "воздуховод",
    "гидки[ий]": "гибкий",
    "озрывозащ": "взрывозащ",
    "устро[б6]ство": "устройство",
    "дючок|/ючок": "лючок",
    "проболок": "проволок",
    "вбзрывозащ|бзрывозащ|взры\\s+возащ": "взрывозащ"
  }
}
