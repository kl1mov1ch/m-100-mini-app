[Unit]
Description=M-100 PDF document queue
After=network-online.target m100-app.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=m100
Group=m100
WorkingDirectory=/var/miniApp/m-100
EnvironmentFile=/var/miniApp/m-100/deploy/secrets/app.env
Environment=OMP_THREAD_LIMIT=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/var/miniApp/m-100/.venv/bin/python -m backend.documents.worker --drain
TimeoutStartSec=infinity
MemoryMax=384M
CPUQuota=50%
TasksMax=32
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/miniApp/m-100/data

