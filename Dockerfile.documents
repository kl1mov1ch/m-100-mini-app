FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils tesseract-ocr tesseract-ocr-rus tesseract-ocr-eng && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN pip install --no-cache-dir 'fastapi>=0.115,<1' 'httpx>=0.28,<1' 'socksio>=1,<2' 'python-dotenv>=1,<2' 'SQLAlchemy==2.0.57' 'psycopg[binary]>=3.3,<4' 'pypdf==6.21.4'
COPY backend/ backend/
COPY docs/ai-system-prompt.md docs/ai-system-prompt.md
RUN useradd --create-home --uid 10001 app && mkdir -p /app/data && chown app:app /app/data
USER app
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "backend.documents.worker"]
