{
	"name": "m100-mini-app",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "tsc -b && vite build",
		"preview": "vite preview --host 127.0.0.1",
		"format": "prettier --write src vite.config.ts index.html package.json tsconfig.json",
		"format:check": "prettier --check src vite.config.ts index.html package.json tsconfig.json"
	},
	"dependencies": {
		"@ant-design/v5-patch-for-react-19": "^1.0.3",
		"antd": "^5.29.0",
		"dayjs": "^1.11.13",
		"lucide-react": "^0.468.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^4.7.0",
		"prettier": "^3.9.10",
		"typescript": "~5.8.3",
		"vite": "^6.3.6"
	}
}
